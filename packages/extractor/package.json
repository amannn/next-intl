{
  "name": "@eloqnt/extractor",
  "version": "0.0.0",
  "description": "Extracts messages from source code for eloqnt and next-intl (internal)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amannn/next-intl.git",
    "directory": "packages/extractor"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./_internal": {
      "types": "./dist/_internal.d.mts",
      "import": "./dist/_internal.mjs",
      "default": "./dist/_internal.mjs"
    },
    "./_internal-transform": {
      "types": "./dist/_internal-transform.d.mts",
      "import": "./dist/_internal-transform.mjs",
      "default": "./dist/_internal-transform.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack --minify src/_internal.ts src/_internal-transform.ts",
    "test": "vp test",
    "lint": "pnpm run lint:source && pnpm run lint:package",
    "lint:source": "eslint src && tsc --noEmit && pnpm run lint:prettier",
    "lint:package": "publint && attw --pack --profile esm-only",
    "lint:prettier": "prettier src --check",
    "prepublishOnly": "turbo build"
  },
  "dependencies": {
    "@eloqnt/messages": "workspace:^",
    "@parcel/watcher": "^2.4.1",
    "@swc/core": "~1.16.0",
    "next-intl-swc-plugin-extractor": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eloqnt/config": "workspace:^",
    "@eloqnt/format-po": "workspace:^",
    "@types/node": "^22.0.0",
    "eslint": "9.11.1",
    "eslint-config-molindo": "^8.0.0",
    "po-parser": "^2.2.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vite-plus": "1.0.0"
  },
  "prettier": "eslint-config-molindo/.prettierrc.json"
}
