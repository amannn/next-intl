{
  "extends": "eslint-config-molindo/tsconfig.json",
  "include": ["src"],
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@eloqnt/config": ["../config/src/index.ts"]
    }
  }
}
